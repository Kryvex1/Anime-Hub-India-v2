{
  "entities": {
    "Admin": {
      "title": "Admin",
      "description": "Authorized administrator records",
      "type": "object",
      "properties": {
        "role": { "type": "string", "description": "Admin role", "enum": ["admin"] },
        "email": { "type": "string", "description": "Admin email" },
        "createdAt": { "type": "number", "description": "Timestamp when added" }
      },
      "required": ["role"]
    },
    "Episode": {
      "title": "Episode",
      "description": "Episode streaming configurations",
      "type": "object",
      "properties": {
        "animeId": { "type": "number", "description": "TMDB Anime ID" },
        "animeTitle": { "type": "string", "description": "Anime Title" },
        "season": { "type": "number", "description": "Season number" },
        "episode": { "type": "number", "description": "Episode number" },
        "episodeTitle": { "type": "string", "description": "Episode Title" },
        "thumbnail": { "type": "string", "description": "Episode thumbnail image URL" },
        "server1": {
          "type": "object",
          "properties": {
            "url": { "type": "string", "description": "Direct HTML5 video URL" }
          }
        },
        "server2": {
          "type": "object",
          "properties": {
            "url": { "type": "string", "description": "Iframe embed URL" }
          }
        },
        "activeServer": { "type": "number", "description": "Default active server (1 or 2)" },
        "updatedAt": { "type": "number", "description": "Last updated timestamp" },
        "updatedBy": { "type": "string", "description": "Admin UID who last updated" }
      },
      "required": ["animeId", "season", "episode", "activeServer", "updatedAt"]
    }
  },
  "firestore": {
    "/admins/{adminId}": {
      "schema": "Admin",
      "description": "Authorized administrators mapped by Firebase Auth UID"
    },
    "/episodes/{episodeId}": {
      "schema": "Episode",
      "description": "Configured episode streaming links mapped by deterministic ID"
    }
  }
}

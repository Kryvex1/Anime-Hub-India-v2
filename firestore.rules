rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Custom Streams & Embeds - Publicly readable for stream playback, editable by authenticated users
    match /customStreams/{streamId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Global Server Configs & Settings - Publicly readable, editable by authenticated users
    match /serverSettings/{settingId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Users collection
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
